{
  "$schema": "https://orderly.claude/schema/brand.v1.json",
  "name": "Orderly Claude",
  "colors": {
    "ink":     { "value": "#15181B", "role": "text",      "aliases": ["text", "foreground"] },
    "muted":   { "value": "#5B6670", "role": "text-weak", "aliases": ["secondary"] },
    "faint":   { "value": "#93999F", "role": "text-faint" },
    "paper":   { "value": "#FFFFFF", "role": "bg",        "aliases": ["background"] },
    "chat":    { "value": "#F7F7F8", "role": "bg-chat" },
    "raised":  { "value": "#F1EFEC", "role": "bg-raised" },
    "line":    { "value": "#E7E3DD", "role": "border" },

    "accent":  { "value": "#415A6B", "role": "accent",    "aliases": ["dusk-blue", "primary"] },
    "warn":    { "value": "#B98A3E", "role": "warn" },
    "fail":    { "value": "#A94E46", "role": "fail",      "aliases": ["error", "danger"] },

    "desert-sand":      { "value": "#D8CFC4", "role": "accent-warm" },
    "midnight-blue":    { "value": "#0D1A24", "role": "bg-deep" },
    "deep-black":       { "value": "#0A0A0A", "role": "bg-dark" }
  },
  "palette": {
    "whitelist": [
      "#15181B", "#5B6670", "#93999F",
      "#FFFFFF", "#F7F7F8", "#F1EFEC", "#E7E3DD",
      "#415A6B", "#B98A3E", "#A94E46",
      "#D8CFC4", "#0D1A24", "#0A0A0A"
    ],
    "allowGrays": true,
    "grayTolerance": 10
  },
  "fonts": {
    "sans":    { "stack": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Helvetica, sans-serif", "families": ["Inter", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Helvetica", "sans-serif"] },
    "mono":    { "stack": "ui-monospace, SFMono-Regular, Menlo, monospace",                                "families": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "monospace"] }
  },
  "spacing": {
    "unit": 4,
    "scale": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96],
    "tolerance": 1
  },
  "radii": {
    "sm": 3,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "contrast": {
    "min": 4.5,
    "preferred": 7
  }
}
